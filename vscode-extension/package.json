{
  "name": "logex-vscode",
  "displayName": "Logex",
  "description": "Prepare blog-style articles from coding-agent sessions via the logex CLI",
  "version": "0.1.0",
  "publisher": "touchskyer",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamtouchskyer/logex"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:logex.writeArticle"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "logex.writeArticle",
        "title": "Logex: Prepare Session for Article"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "package": "vsce package --out ../logex-vscode.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20",
    "typescript": "^5",
    "@vscode/vsce": "^2"
  }
}
